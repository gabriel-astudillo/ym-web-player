@startuml
!theme plain
skinparam BoxPadding 10
skinparam ParticipantPadding 10
autonumber

actor "Usuario / UI" as User
participant "AYM_PlayerView\n(View)" as View
participant "AYM_Player\n(Controller)" as Controller
participant "ChiptuneFile\n(Decoder/LHA)" as Decoder
participant "AYM_PlayerModel\n(Model)" as Model
participant "AYM_PlayerProcessor\n(AudioWorklet)" as Processor
participant "AYM_Emulator\n(Chip Emulation)" as Emulator

== 1. Inicialización y Encendido del Emulador ==

User -> View : Click en #aymPower [Power]
activate View
View -> Controller : onClickPower()
activate Controller

Controller -> Model : isNotPowered()
activate Model
Model --> Controller : true
deactivate Model

Controller -> Model : powerOn()
activate Model
Model -> Model : createContext()
Model -> Model : createWorklet() (AudioWorkletNode)
Model -> Model : createAnalyser()
Model -> Model : createGain()
Model -> Processor : postMessage({ message_type: 'State' })
Model --> Controller
deactivate Model

Controller -> View : powerOn()
View -> View : setStatusDisplay('AYM Player is On')
View -> View : resetFrameDisplay()
View --> User
deactivate Controller
deactivate View

== 2. Carga y Decodificación de Archivo .ym ==

User -> View : Selecciona archivo .ym (#file-picker o .ym-link)
activate View
View -> Controller : onFileSelected(file)
activate Controller
Controller -> View : setStatusDisplay("Cargando y descomprimiendo...")

Controller -> Decoder : new ChiptuneFile()
Controller -> Decoder : loadFile(file)
activate Decoder

Decoder -> Decoder : detectFormat(view)
alt Formato Comprimido LHA (-lh5-)
    Decoder -> Decoder : decompressLh5File_GAM(arrayBuffer)
else Formato YM Directo (YM2/3/5/6)
    Decoder -> Decoder : decodeYmFile(view, uint8Array)
end

opt Es Interleaved (interleaved == 1)
    Decoder -> Decoder : Deinterleave registers (14 canales)
end

Decoder -> Decoder : Reconstrucción matricial de frames
Decoder --> Controller : getData() -> [songData, nFrames, interleaved]
deactivate Decoder

Controller -> View : populateFramesContainer(songData, nFrames)
activate View
View -> View : Renderiza filas DOM (F#0000 0x.. 0x..)
deactivate View

Controller -> View : setTotalFrames(nFrames)
Controller -> View : setStatusDisplay("NombrePista...OK")
deactivate Controller
deactivate View

== 3. Inicio de Reproducción ==

User -> View : Click en #aymFilePlay [Play]
activate View
View -> Controller : onClickFilePlay()
activate Controller
Controller -> Model : sendExternalTrack(externalMusic)
activate Model
Model -> Processor : postMessage({ message_type: 'PlayExternal', message_data: extMusic })
deactivate Model
deactivate Controller
deactivate View

activate Processor
Processor -> Processor : Configura buffers y frame rate (50 Hz)
Processor -> Emulator : reset()
activate Emulator
deactivate Emulator

Processor -> Model : postMessage({ message_type: 'PlayingFile' })
activate Model
Model -> Controller : recvPlayingFile()
activate Controller
Controller -> View : setPlayingFile()
deactivate Controller
deactivate Model

== 4. Ciclo de Emulación y Sincronización en Tiempo Real (Audio Loop) ==

loop Cada bloque de audio (AudioWorklet process)
    Processor -> Processor : clockChip()
    
    loop Para cada muestra (sampleRate vs chipClock)
        Processor -> Emulator : clock()
        activate Emulator
        Emulator -> Emulator : fixup_tones()
        Emulator -> Emulator : Generadores (Tone, Noise, Envelope, Mixer)
        deactivate Emulator
        
        opt Tick de música alcanzado (clockMusic)
            Processor -> Processor : Extrae frame actual (14 registros)
            loop Registro 0 al 13
                Processor -> Emulator : set_register_index(i)
                Processor -> Emulator : set_register_value(val)
            end
            
            Processor -> Model : postMessage({ message_type: 'Frame', message_data: music_index })
            activate Model
            Model -> Controller : recvFrame(nFrame)
            activate Controller
            Controller -> View : updateCurrentFrame(nFrame)
            activate View
            Controller -> View : highlightFrame(nFrame)
            View -> View : Prepend / Scroll Top de la fila activa
            deactivate View
            deactivate Controller
            deactivate Model
        end
    end
    
    Processor -> Processor : mixStereo() / Separa canales puros (Outputs 0,1,2,3)
end

== 5. Detención de Reproducción ==

User -> View : Click en #aymFileStop [Stop]
activate View
View -> Controller : onClickFileStop()
activate Controller
Controller -> Model : sendStopFile()
activate Model
Model -> Processor : postMessage({ message_type: 'StopFile' })
deactivate Model
deactivate Controller

Processor -> Processor : chip_flags |= RESET, music_index = -1
Processor -> Model : postMessage({ message_type: 'StoppedFile' })
activate Model
Model -> Controller : recvStoppedFile()
activate Controller
Controller -> View : setStoppedFile()
activate View
View -> View : resetFrameDisplay()
deactivate View
deactivate Controller
deactivate Model
deactivate View

@enduml